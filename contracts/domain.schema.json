{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "涉老取款紧急干预领域事件",
  "description": "用于跨模块交换事实记录的公共信封。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "TRANSACTION_FLAGGED",
        "SELF_EXPRESSION_RECORDED",
        "COMPANION_PROFILE_RECORDED",
        "CONTACT_ATTEMPTED",
        "SUPERVISOR_REVIEWED",
        "SIGNAL_RECORDED",
        "SIGNAL_CONFIRMED",
        "SIGNAL_RETRACTED",
        "HOLD_APPLIED",
        "HOLD_EXTENDED",
        "HOLD_LIFTED",
        "DECISION_RECORDED",
        "FUNDS_RELEASED",
        "APPEAL_FILED",
        "APPEAL_REVIEWED",
        "AUTHORITY_RESPONDED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "withdrawal_case",
        "observed_signal",
        "protective_hold",
        "final_decision"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "业务载荷，字段约定见 src/intervention/events.py"
    }
  },
  "additionalProperties": true
}
